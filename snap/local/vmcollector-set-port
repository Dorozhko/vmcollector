#!/bin/sh
set -eu

CONFIG="$SNAP_COMMON/config.json"
EXAMPLE="$SNAP/config.example.json"

if [ ! -f "$CONFIG" ]; then
    mkdir -p "$SNAP_COMMON"
    cp "$EXAMPLE" "$CONFIG"
    chmod 600 "$CONFIG"
fi

if [ "$#" -ne 1 ]; then
    echo "Usage: snap run vmcollector.set-port <port>" >&2
    exit 1
fi

exec "$SNAP/bin/vmcollector" -config="$CONFIG" -set-port="$1"
